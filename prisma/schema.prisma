// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  // output   = "../node_modules/.prisma/client"
  binaryTargets = ["native", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String  @id @default(uuid())
  fullName  String?
  firstName String?
  lastName  String?
  email     String  @unique
  password  String?
  picture   String?
  role      Role    @default(USER)
  provider  String  @default("local")

  userAttempts UserAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens         RefreshToken[]
  rapidFireOverallStats RapidFireOverallStat[]
  rapidFireLessonStats  RapidFireLessonStat[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)

  @@index([userId])
}

enum JlptLevel {
  N4
  N5
}

enum CategoryType {
  GRAMMAR
  VOCABULARY
  LISTENING
}

model Rule {
  id    String @id @default(uuid())
  name  String @unique
  rules Json?

  modules Module[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id                 String       @id @default(uuid())
  slug               String       @unique
  name               String
  description        String
  learningObjectives Json?
  instructions       Json?
  motivationalQuote  String
  jlptLevel          JlptLevel
  categoryType       CategoryType
  questions          Question[]
  quizzes            Quiz[]
  quizConfigs        QuizConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessons   Lesson[]
  rule      Rule?    @relation(fields: [ruleId], references: [id])
  ruleId    String?

  @@index([slug])
}

model Lesson {
  id           String @id @default(uuid())
  title        String
  lessonNumber Int

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  grammarRules GrammarRule[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  rapidFireLessonStats RapidFireLessonStat[]

  @@index([moduleId])
}

model RapidFireLesson {
  id           String                 @id @default(uuid())
  title        String
  lessonNumber Int
  jlptLevel    JlptLevel              @default(N5)
  words        RapidFireWord[]
  practicedBy  RapidFireOverallStat[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now())
  rapidFireLessonStats RapidFireLessonStat[]

  @@index([jlptLevel])
}

model RapidFireWord {
  id                String          @id @default(uuid())
  word              String
  reading           String
  romaji            String
  meaning           String
  rapidFireLessonId String
  rapidFireLesson   RapidFireLesson @relation(fields: [rapidFireLessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rapidFireLessonId])
}

model RapidFireOverallStat {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jlptLevel        JlptLevel         @default(N5)
  lessonsPracticed RapidFireLesson[]
  masteryRate      Int               @default(0)
  totalHardWords   Int               @default(0)
  totalLessons     Int               @default(25)
  totalAnswers     Int               @default(0)
  totalCorrect     Int               @default(0)

  lessonStats RapidFireLessonStat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jlptLevel])
  @@index([userId])
}

model RapidFireLessonStat {
  id                String               @id @default(uuid())
  overallStatId     String
  overallStat       RapidFireOverallStat @relation(fields: [overallStatId], references: [id], onDelete: Cascade)
  rapidFireLessonId String
  rapidFireLesson   RapidFireLesson      @relation(fields: [rapidFireLessonId], references: [id], onDelete: Cascade)
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonNumber      Int
  totalWords        Int                  @default(0)
  masteryRate       Int                  @default(0)
  hardWordCount     Int                  @default(0)
  totalAnswers      Int                  @default(0)
  totalCorrect      Int                  @default(0)
  lastPracticed     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson?  @relation(fields: [lessonId], references: [id])
  lessonId  String?

  @@unique([overallStatId, rapidFireLessonId])
  @@index([rapidFireLessonId])
  @@index([userId])
  @@index([overallStatId])
}

model GrammarRule {
  id String @id @default(uuid())

  japanese     String
  romaji       String?
  englishTitle String
  description  String

  structurePattern String?
  usageNotes       String?

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  examples GrammarExample[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
}

model GrammarExample {
  id String @id @default(uuid())

  japaneseSentence   String
  englishTranslation String

  grammarRuleId String
  grammarRule   GrammarRule @relation(fields: [grammarRuleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([grammarRuleId])
}

enum QuestionType {
  GRAMMAR
  VOCABULARY
  KANJI
}

model Question {
  id            String       @id @default(uuid())
  content       String
  options       Json
  correctAnswer String
  explanation   String?
  questionType  QuestionType

  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId String

  quizzes QuizQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model QuizConfig {
  id           String  @id @default(uuid())
  name         String?
  numQuestions Int
  durationSec  Int

  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId String

  quizzes Quiz[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model Quiz {
  id        String    @id @default(uuid())
  title     String
  jlptLevel JlptLevel

  module   Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId String?

  quizConfig   QuizConfig? @relation(fields: [quizConfigId], references: [id], onDelete: SetNull)
  quizConfigId String?

  questions    QuizQuestion[]
  userAttempts UserAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id])
  @@index([moduleId])
  @@index([quizConfigId])
}

model QuizQuestion {
  id    String @id @default(uuid())
  order Int

  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId String

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String

  userAnswers UserAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quizId, questionId])
  @@index([quizId])
  @@index([questionId])
}

model UserAttempt {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId String

  userAnswers UserAnswer[]

  score           Int
  normalizedScore Float?
  completed       Boolean   @default(false)
  startedAt       DateTime  @default(now())
  submittedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([quizId])
  @@index([startedAt])
}

model UserAnswer {
  id String @id @default(uuid())

  userTestAttempt UserAttempt @relation(fields: [userAttemptId], references: [id], onDelete: Cascade)
  userAttemptId   String

  quizQuestion   QuizQuestion @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)
  quizQuestionId String

  answer  String?
  correct Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userAttemptId])
  @@index([quizQuestionId])
}
